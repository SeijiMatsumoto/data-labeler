{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Labeldesk dataset v1",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "rubric", "items"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "instructions": { "type": "string" },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["values"],
        "properties": {
          "values": { "type": "object" },
          "skipped": { "type": "boolean" },
          "updatedAt": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "not": { "enum": ["__proto__", "constructor", "prototype"] }
    },
    "field": {
      "type": "object",
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["binary", "likert", "text", "single-select", "multi-select"]
        },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "anchors": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "likert" } } },
          "then": { "required": ["min", "max"] }
        },
        {
          "if": {
            "properties": {
              "type": { "enum": ["single-select", "multi-select"] }
            }
          },
          "then": { "required": ["options"] }
        }
      ]
    },
    "item": {
      "type": "object",
      "required": ["id", "blocks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "metadata": { "type": "object" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "block": {
      "type": "object",
      "required": ["label", "type", "value"],
      "properties": {
        "label": { "type": "string" },
        "type": { "enum": ["text", "markdown", "json", "code", "chat"] },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "enum": ["text", "markdown", "code"] } }
          },
          "then": { "properties": { "value": { "type": "string" } } }
        },
        {
          "if": { "properties": { "type": { "const": "chat" } } },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["role", "content"],
                  "properties": {
                    "role": { "type": "string" },
                    "content": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$comment": "Runtime validation additionally checks unique item/field IDs, min < max, maximum 11 scale values, whitespace-only IDs/labels/options, annotation field values, and annotation item references."
}
